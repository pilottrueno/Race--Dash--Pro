[Unit]
Description=RACE DASH PRO - Professional Racing Dashboard
After=network.target multi-user.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
WorkingDirectory=/home/pi/dashboard
ExecStartPre=/usr/bin/xinit
ExecStart=/usr/bin/python3 /home/pi/dashboard/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
